# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gigconnect
JWT_SECRET=replace-with-a-long-random-string

# Razorpay test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Frontend origin(s) allowed by CORS, comma-separated. Leave empty to allow all (dev only).
CLIENT_URL=http://localhost:5173

# Set to "true" ONLY for demos: lets a failed Razorpay test payment be marked as paid.
ALLOW_TEST_PAYMENT_BYPASS=false
